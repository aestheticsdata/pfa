generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

model Categories {
  ID         String       @id @db.Char(36)
  userID     String?      @db.Char(36)
  name       String       @db.VarChar(20)
  color      String       @db.VarChar(20)
  spendings  Spendings[]
  recurrings Recurrings[]

  @@index([userID])
}

model Dashboards {
  ID             String   @id @db.Char(36)
  dateFrom       DateTime @db.Date
  dateTo         DateTime @db.Date
  initialAmount  Decimal  @db.Decimal(6, 2)
  userID         String   @db.Char(36)
  initialCeiling Decimal? @db.Decimal(6, 2)

  @@index([userID, dateFrom])
}

model Recurrings {
  ID          String      @id @db.Char(36)
  userID      String      @db.Char(36)
  dateFrom    DateTime    @db.Date
  dateTo      DateTime    @db.Date
  itemType    String      @db.VarChar(11)
  label       String      @db.VarChar(100)
  amount      Decimal     @db.Decimal(6, 2)
  currency    String?     @db.VarChar(3)
  invoicefile String?     @db.VarChar(255)
  categoryID  String?     @db.Char(36)
  category    Categories? @relation(fields: [categoryID], references: [ID])

  @@index([userID, dateFrom])
  // Same name MySQL gives the FK's auto index, so `migrate diff` stays clean.
  @@index([categoryID], map: "Recurrings_categoryID_fkey")
}

model Spendings {
  ID           String          @id @db.Char(36)
  userID       String          @db.Char(36)
  date         DateTime        @db.Date
  itemType     String          @db.VarChar(11)
  label        String          @db.VarChar(100)
  amount       Decimal         @db.Decimal(6, 2)
  categoryID   String?         @db.Char(36)
  currency     String?         @db.VarChar(3)
  invoicefile  String?         @db.VarChar(255)
  // A line of a group (one receipt, several categories — PFA-189). `label`
  // stays the composed "<group> — <detail>" so every reader of the table
  // (stats, search, export, suggestions) keeps working unchanged.
  groupID      String?         @db.Char(36)
  detail       String?         @db.VarChar(100)
  category     Categories?     @relation(fields: [categoryID], references: [ID])
  group        SpendingGroups? @relation(fields: [groupID], references: [ID], onDelete: Cascade)
  // The receipt's line items, read by OCR then checked by the user (PFA-214).
  receiptLines ReceiptLines[]
  // Where it was bought, read on the receipt then checked by the user (PFA-218).
  storeID      String?         @db.Char(36)
  store        Stores?         @relation(fields: [storeID], references: [ID], onDelete: SetNull)

  // MySQL auto-creates this index with the FK constraint; declaring it (same
  // name) keeps `migrate diff` clean instead of reporting it as drift forever.
  @@index([categoryID], map: "Spendings_categoryID_fkey")
  @@index([groupID], map: "Spendings_groupID_fkey")
  @@index([storeID], map: "Spendings_storeID_fkey")
  @@index([userID, date])
}

// One line of a spending's receipt (PFA-214): proposed by the local OCR,
// corrected and accepted by the user. Gone with its spending.
model ReceiptLines {
  ID            String        @id @db.Char(36)
  spendingID    String        @db.Char(36)
  position      Int
  label         String        @db.VarChar(100)
  amount        Decimal       @db.Decimal(6, 2)
  // What a unit price needs (PFA-219): how many were bought, and the size of
  // one (1 L, 250 g; null when sold by the piece). A weighed item is one item
  // of its weight.
  quantity      Decimal       @default(1) @db.Decimal(8, 3)
  size          Decimal?      @db.Decimal(8, 3)
  sizeUnit      String?       @db.VarChar(2)
  // The generic product it is, across brands and stores (PFA-219).
  productTypeID String?       @db.Char(36)
  spending      Spendings     @relation(fields: [spendingID], references: [ID], onDelete: Cascade)
  productType   ProductTypes? @relation(fields: [productTypeID], references: [ID], onDelete: SetNull)

  @@index([spendingID])
  @@index([productTypeID], map: "ReceiptLines_productTypeID_fkey")
}

// A generic product the user compares between stores (PFA-219): "Liquid soap",
// all brands together. `nameKey` is the name upper-cased, accents and
// punctuation dropped, like a store's.
model ProductTypes {
  ID           String         @id @db.Char(36)
  userID       String         @db.Char(36)
  name         String         @db.VarChar(40)
  nameKey      String         @db.VarChar(40)
  receiptLines ReceiptLines[]

  @@unique([userID, nameKey])
}

// A shop the user buys from (PFA-218), one per spelling and address: `nameKey`
// is the name upper-cased, accents and punctuation dropped, so "Épicerie du
// Parc" and "EPICERIE DU PARC" at one address are one store.
model Stores {
  ID         String      @id @db.Char(36)
  userID     String      @db.Char(36)
  name       String      @db.VarChar(60)
  nameKey    String      @db.VarChar(60)
  // Two shops of one chain are two stores, priced apart (PFA-219): the address
  // tells them apart. `addressKey` is it normalised, "" when unknown.
  address    String?     @db.VarChar(120)
  addressKey String      @default("") @db.VarChar(120)
  spendings  Spendings[]

  @@unique([userID, nameKey, addressKey])
}

// Several spendings bought on one receipt (PFA-189). The receipt itself is the
// `invoicefile` shared by all the group's lines — there is no receipt table: a
// file shared by N rows is a shared receipt, grouped or not.
model SpendingGroups {
  ID        String      @id @db.Char(36)
  userID    String      @db.Char(36)
  date      DateTime    @db.Date
  label     String      @db.VarChar(100)
  spendings Spendings[]

  @@index([userID])
}

model Exceptionals {
  ID            String   @id @db.Char(36)
  userID        String   @db.Char(36)
  date          DateTime @db.Date
  itemType      String   @db.VarChar(11)
  label         String   @db.VarChar(100)
  description   String?  @db.VarChar(255)
  amount        Decimal  @db.Decimal(10, 2)
  currency      String?  @db.VarChar(3)
  categoryName  String?  @db.VarChar(50)
  categoryColor String?  @db.VarChar(20)
  invoicefile   String?  @db.VarChar(255)

  @@index([userID, date])
}

model Users {
  ID           String    @id @db.Char(36)
  name         String    @db.VarChar(20)
  password     String    @db.VarChar(60)
  email        String    @unique @db.VarChar(250)
  registerDate DateTime? @db.DateTime(0)
  language     String?   @default("en") @db.VarChar(3)
  baseCurrency String    @db.VarChar(3)
  // A bot account of the synthetic-users runner (PFA-122): set at signup when
  // the email is on the reserved domain, never otherwise. `synthetic:purge`
  // deletes these accounts and everything they own.
  isSynthetic  Boolean   @default(false)
  // A bot account switched off from the bot back-office (PFA-127): sign-in refused, sessions
  // revoked, data kept. Only ever set on a synthetic account, never on a person's.
  disabledAt   DateTime? @db.DateTime(3)
}
