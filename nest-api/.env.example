# Required for Prisma (generate, migrate) and Nest when running with pnpm (start:dev).
# Not used in production: pm2 injects vars from root ecosystem.config.js.
# Copy this file to .env and fill in your values.

DATABASE_URL=mysql://user:password@localhost:3306/pfa
PORT=6100
JWT_SECRET=your-jwt-secret
# Invoice images storage (relative to nest-api). Prod: /home/pfa/invoicesUpload/ via ecosystem.
PFA_INVOICES_IMAGES_PATH=./invoicesUpload/

# DB backup cron (production only). Prod: via ecosystem.config.js.
# DB_USER=root
# DB_PASSWORD=...
# DB=pfa
# PFA_DUMP_PATH=/home/pfa/mysqldump/
# PFA_BACKUP_SERVER_PATH=/home/debian/pfabackupdb/

# Cron reporting to Zeus (COS-422). Prod: via ecosystem.config.js.
#
# With ZEUS_INGEST_TOKEN or ZEUS_APP_NAME unset the helper is a silent no-op, so pfa runs
# identically on a laptop with no Zeus in sight. Set all three or none — a partial set reports
# nothing and says nothing about it.
#
# ZEUS_APP_NAME must match pfa's slug in Zeus's port registry, which is what the endpoint checks
# the report against. The token is the same value as Zeus's own ZEUS_INGEST_TOKEN.
# ZEUS_INGEST_URL=http://127.0.0.1:6600/api/cron-runs
# ZEUS_INGEST_TOKEN=...
# ZEUS_APP_NAME=pfa
