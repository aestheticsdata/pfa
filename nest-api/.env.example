# Every variable the API reads (PFA-264). Checked at start-up by src/config/env.validation.ts — a
# missing or malformed one stops the boot with its name — and read through `env` (src/config/env.ts).
# Required for Prisma (generate, migrate) and Nest when running with pnpm (start:dev).
# Not used in production: pm2 injects vars from root ecosystem.config.js.
# Copy this file to .env and fill in your values.

# --- Always required ---
DATABASE_URL=mysql://user:password@localhost:3306/pfa
PORT=6100
# 16 characters at least.
SESSION_SECRET=a-long-random-session-secret

# --- Optional (default) ---
# NODE_ENV=development            # production | test | development
# REDIS_URL=redis://localhost:6379
# FRONTEND_URL=http://localhost:3000   # the CORS origin
# COOKIE_SECURE=true              # false only for a production served without HTTPS
# LOG_LEVEL=debug                 # fatal | error | warn | info | debug | trace | silent (default: info in production)
# SIGNUPS_ENABLED=true            # false closes sign-ups (the bot runner still gets in)

# --- Required in production ---
# Invoice images storage (relative to nest-api). Prod: /home/pfa/invoicesUpload/ via ecosystem.
PFA_INVOICES_IMAGES_PATH=./invoicesUpload/

# SSH backup of the receipts to memosyne (production only). Prod: via ecosystem.config.js.
# PFA_BACKUP_SERVER_IP=
# DEBIAN_OVH_VPS_SSH_USER=
# DEBIAN_OVH_VPS_SSH_KEY_PATH=
# PFA_BACKUP_INVOICES_SERVER_PATH=

# DB backup cron (production only). Prod: via ecosystem.config.js.
# DB_USER=root
# DB_PASSWORD=...
# DB=pfa
# PFA_DUMP_PATH=/home/pfa/mysqldump/
# PFA_BACKUP_SERVER_PATH=/home/debian/pfabackupdb/

# Cron reporting to Zeus (COS-422). Prod: via ecosystem.config.js.
#
# With ZEUS_INGEST_TOKEN or ZEUS_APP_NAME unset the helper is a silent no-op, so pfa runs
# identically on a laptop with no Zeus in sight. Set all three or none — a partial set reports
# nothing and says nothing about it.
#
# ZEUS_APP_NAME must match pfa's slug in Zeus's port registry, which is what the endpoint checks
# the report against. The token is the same value as Zeus's own ZEUS_INGEST_TOKEN.
# ZEUS_INGEST_URL=http://127.0.0.1:6600/api/cron-runs
# ZEUS_INGEST_TOKEN=...
# ZEUS_APP_NAME=pfa

# Synthetic users (PFA-122): the only client addresses a bot account (@synthetic.test) may be
# used from — the bot runner's host. Comma-separated. Unset or empty = every bot request refused.
# Locally, for a runner on this machine: 127.0.0.1,::1
# SYNTHETIC_ALLOWED_IPS=

# Synthetic users (PFA-127): the bot runner's token for /api/internal/synthetic/accounts (disable or
# purge one bot account, from the bot back-office). 32+ characters; unset = the route answers 404.
# Only reachable from ks-b itself, never through nginx. Generate: openssl rand -hex 32
# SYNTHETIC_ADMIN_TOKEN=
