# Required for Prisma (generate, migrate) and Nest when running with pnpm (start:dev).
# Not used in production: pm2 injects vars from root ecosystem.config.js.
# Copy this file to .env and fill in your values.

DATABASE_URL=mysql://user:password@localhost:3306/pfa
PORT=6100
LEGACY_API_PORT=6101
JWT_SECRET=your-jwt-secret
# Invoice images storage (relative to nest-api). Prod: /home/pfa/invoicesUpload/ via ecosystem.
PFA_INVOICES_IMAGES_PATH=./invoicesUpload/
