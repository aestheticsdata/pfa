{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "scripts/**",
      "*.ts",
      "*.mjs",
      "!generated",
      "!dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      },
      "complexity": {
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        }
      },
      "style": {
        "useImportType": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.controller.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/shared-kernel/**",
        "src/contexts/*/domain/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "sharp": "The domain is pure TypeScript (PFA-272): image work is an adapter in infrastructure/.",
                  "tesseract.js": "The domain is pure TypeScript (PFA-272): OCR is an adapter in infrastructure/.",
                  "redis": "The domain is pure TypeScript (PFA-272): Redis is an adapter in infrastructure/.",
                  "node:fs": "The domain is pure TypeScript (PFA-272): files are an adapter in infrastructure/.",
                  "node:fs/promises": "The domain is pure TypeScript (PFA-272): files are an adapter in infrastructure/.",
                  "express": "The domain is pure TypeScript (PFA-272): HTTP belongs in interface/."
                },
                "patterns": [
                  {
                    "group": ["@nestjs/*", "@prisma/*", "@generated/*", "@db/*", "**/generated/prisma/**", "**/prisma/prisma.service", "nestjs-pino"],
                    "message": "The domain is pure TypeScript (PFA-272): frameworks and persistence plug in from infrastructure/, through a port."
                  },
                  {
                    "group": ["@contexts/*/application/**", "@contexts/*/infrastructure/**", "@contexts/*/interface/**"],
                    "message": "Dependencies point inwards (PFA-272): the domain never imports the layers around it."
                  },
                  {
                    "group": ["@spendings/*", "@categories/*", "@recurrings/*", "@exceptionals/*", "@dashboard/*", "@stats/*", "@users/*", "@infrastructure/*", "@monitoring/*", "@redis/*", "@config/*", "!@config/field-limits"],
                    "message": "The domain does not reach into the legacy feature modules (PFA-272): ask through a port. Field limits are plain constants and allowed."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
