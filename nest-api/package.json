{
  "name": "nest-api",
  "packageManager": "pnpm@12.2.1",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "build:deploy": "prisma generate && nest build --no-type-check",
    "format": "biome format --write .",
    "start": "nest start",
    "dev": "concurrently \"redis-server\" \"pnpm start:dev\"",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r tsconfig-paths/register dist/src/main.js",
    "seed": "TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"Node\",\"resolvePackageJsonExports\":false}' node -r ts-node/register scripts/seed.ts",
    "synthetic:purge": "TS_NODE_TRANSPILE_ONLY=1 TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"Node\",\"resolvePackageJsonExports\":false}' node -r ts-node/register scripts/synthetic-purge.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "bash test/launch-redis-for-tests.sh && NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:debug": "bash test/launch-redis-for-tests.sh && NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-e2e.json --runInBand --detectOpenHandles",
    "test:ssh": "export $(grep -v '^#' .env.ssh-test | xargs) && NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-e2e.json --testRegex='ssh-backup\\.integration\\.ts$'"
  },
  "dependencies": {
    "@elastic/ecs-pino-format": "^1.5.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tesseract.js-data/fra": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "connect-redis": "^9.0.0",
    "date-fns": "^4.4.0",
    "express-session": "^1.19.0",
    "mariadb": "^3.5.4",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "ssh2": "^1.17.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@nestjs/cli": "^12.0.9",
    "@nestjs/schematics": "^12.0.9",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.5",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@redis/redis\\.(.*)$": "<rootDir>/redis/redis.$1",
      "^@redis/interfaces/(.*)$": "<rootDir>/redis/interfaces/$1",
      "^@users/(.*)$": "<rootDir>/users/$1",
      "^@spendings/(.*)$": "<rootDir>/spendings/$1",
      "^@stats/(.*)$": "<rootDir>/stats/$1",
      "^@categories/(.*)$": "<rootDir>/categories/$1",
      "^@monitoring/(.*)$": "<rootDir>/monitoring/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
