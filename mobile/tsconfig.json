{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@auth/*": [
        "./src/auth/*"
      ],
      "@charts/*": [
        "./src/charts/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@navigation/*": [
        "./src/navigation/*"
      ],
      "@screens/*": [
        "./src/screens/*"
      ],
      "@stores/*": [
        "./src/stores/*"
      ],
      "@text/*": [
        "./src/text/*"
      ],
      "@theme/*": [
        "./src/theme/*"
      ],
      "@ui/*": [
        "./src/ui/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "design"
  ]
}
