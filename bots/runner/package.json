{
  "name": "bot-runner",
  "private": true,
  "version": "0.1.0",
  "description": "Synthetic users: bots that use the app over HTTP like real people (PFA-120).",
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "bot:once": "tsx src/cli/runOnce.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
