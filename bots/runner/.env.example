# bot-runner — copy to .env (gitignored) or set in the PM2 config. See README.md.

# Service token of the control API. Required, 32+ characters: `openssl rand -hex 32`.
RUNNER_CONTROL_TOKEN=
# Control API port, always bound to 127.0.0.1.
# RUNNER_CONTROL_PORT=7201

# Where the runner keeps its state: bots' passwords (0600), kill switch, upload ledger.
# RUNNER_STATE_DIR=.runner-state

# Hard caps — can be lowered here, never raised above the defaults.
# RUNNER_MAX_BOTS=500
# RUNNER_MAX_RPS=40
# RUNNER_UPLOAD_BUDGET_MB=400

# PFA's API, the public one in production so the bots cross nginx and the IP lock (PFA-122):
#   https://pfa.1991computer.com/api
# Locally: the dev API, started with SYNTHETIC_ALLOWED_IPS=127.0.0.1,::1
# PFA_API_URL=http://127.0.0.1:6100/api

# Disable / purge a bot account from the back-office (PFA-127): PFA's internal route, reached on
# 127.0.0.1 only (never through nginx). Same value as SYNTHETIC_ADMIN_TOKEN in PFA's API env.
# Unset = the back-office can't close accounts.
# PFA_INTERNAL_API_URL=http://127.0.0.1:6100/api
# SYNTHETIC_ADMIN_TOKEN=
