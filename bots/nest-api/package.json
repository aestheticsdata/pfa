{
  "name": "bots-nest-api",
  "packageManager": "pnpm@12.2.1",
  "version": "0.0.1",
  "description": "Bot back-office API — auth, apps, runner proxy, incidents, push (PFA-127)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#app/*": "./dist/src/*",
    "#prisma-client/*": "./dist/generated/prisma/*"
  },
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "lint": "biome check ."
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "connect-redis": "^10.0.0",
    "express-session": "^1.19.0",
    "mariadb": "^3.5.4",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
