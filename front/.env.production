# COS-419: sign-ups locked down to the owner. Set to "true" to reopen registration.
# Inlined into the JS bundle at `next build` time (NEXT_PUBLIC_*), so this must live in
# .env.production and not in ecosystem.config.cjs (PM2 env is too late for these vars).
NEXT_PUBLIC_SIGNUPS_ENABLED=false

# Browser error/event reporting to Iknos (its IKN-29). `src/lib/report.ts` and
# `src/instrumentation-client.ts` are copies of Iknos' reference client — the contract is the
# HTTP shape, not the file, same doctrine as zeus-report.ts on the API side.
#
# Absolute URL: unlike Iknos' own front, this page posts to ANOTHER subdomain. Three walls had
# to open for that — this CSP's connect-src, CORS on the Iknos API, and the origin allowlist in
# Iknos' ecosystem.config.js. Remove one and the report dies silently, by design.
NEXT_PUBLIC_IKNOS_INGEST_URL=https://iknos.1991computer.com/api/ingest
# Must exist and be enabled in Iknos' `service` table.
NEXT_PUBLIC_IKNOS_SERVICE=pfa-front
# The token is NOT set here — this file is tracked. It lives in `.env.production.local` on ks-b
# (higher Next precedence, excluded from rsync, carried release to release by deploy-front.sh's
# copy-if-absent loop). Seed it once with the value from Iknos' ecosystem.config.js:
#   ssh debian@ks-b 'umask 077 && printf "NEXT_PUBLIC_IKNOS_INGEST_TOKEN=%s\n" "<TOKEN>" > /var/www/pfa/public_html/.env.production.local'
# Empty or absent, the reporter compiles to nothing — zero bytes of it in the bundle.
