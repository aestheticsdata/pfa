# Playwright E2E credentials — copy to .env.test.local (git-ignored) and fill in.
# The account must exist locally: sign it up once at `/signup`, then fill it with `pnpm seed` in nest-api.
E2E_EMAIL=local.dev@mock.io
E2E_PASSWORD=

# Read by `e2e/demo/demo.setup.ts` and the storyboard, checked by `e2e/demo/preflight.ts`.
# The house dev account, the same one every project here uses — never a real one, because the
# take is filmed for a public page.
DEMO_USERNAME=local.dev@mock.io
DEMO_PASSWORD=azertyazerty
